# =======================================
# PROJECT-SPECIFIC IGNORE RULES
# =======================================

# Ignore local configuration files
.env
*.env
.envrc
.env.*
.env.local
*.config.local.*
*.override.yml
*.override.json
config.*.json

# Ignore secrets and access keys (ISO 27001, NIST 800-53)
secrets/
**/.ssh/
**/.aws/
**/.gcp/
**/id_rsa*
**/config
**/credentials
access_tokens/
.vault_pass
.git-credentials
*.key
*.pem
*.crt
*.pfx
*.p12

# Ignore authentication and security-related files
.htpasswd
.htaccess
.user.ini
*.token
*.api_key

# =======================================
# GIT & VERSION CONTROL
# =======================================

# Ignore Git metadata
.git/
.gitignore
.gitattributes

# Ignore DVC files
.dvc/
.dvcignore
.dvc/tmp/
.dvc/cache/

# =======================================
# BUILD, CACHE & BYTECODE FILES
# =======================================

# Python-related caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dll
*.o
*.obj
*$py.class

# Node.js and frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System and editor files
*.DS_Store
*.swp
*.temp
*.tmp
*.bak
.cache/

# Package managers & dependencies
*.lock
package-lock.json
yarn-lock.json
.pipenv
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE and workspace files
.vscode/
.idea/
*.sublime-workspace

# =======================================
# DISTRIBUTION & PACKAGING FILES
# =======================================

# Build artifacts
build/
dist/
target/
*.egg-info/
*.whl
*.tar.gz
*.zip
*.tgz
wheels/
share/python-wheels/

# PyInstaller
*.manifest
*.spec

# =======================================
# DOCUMENTATION & LOG FILES
# =======================================

# Ignore documentation build files
/docs/_build/
/docs/api/
*.md
*.rst
*.log
logs/
debug.log
error.log

# Test results and coverage reports
.tests/
__tests__/
*.test.js
*.spec.js
.tox/
.nox/
coverage/
coverage.*
.coverage
.coverage.*
pytest_cache/
.coverage.xml
nosetests.xml
htmlcov/

# =======================================
# DOCKER, INFRA & SECURITY FILES
# =======================================

# Ignore Docker-related files
compose.yml
compose.*.yml
.docker/
.dockercfg
.docker/config.json
.trivyignore
.containerignore

# Terraform and cloud configs
.terraform/
*.tfstate
*.tfvars
*.tfvars.json
terraform.tfstate*
.vagrant/
*.publishsettings
.gcloud/
.azure/
.aws/

# Ignore database and runtime files
db_backups/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
.pgpass
my.cnf
.mysqlpass
oracle_jre_usage/

# =======================================
# MACHINE LEARNING & DATA FILES
# =======================================

# Ignore IPython notebooks (not typically needed in container)
*.ipynb
notebooks/

# Ignore MLflow and checkpoints
mlruns/
mlartifacts/
outputs/
mlflow.db
checkpoints/
model_weights/
models/

# Ignore ML models and serialized files
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.pb
*.tflite
*.onnx
*.keras
*.savedmodel/

# Ignore structured data files
*.csv
*.tsv
*.xlsx
*.xls
*.ods
*.parquet
*.feather
*.arrow
*.avro

# Ignore notebooks cache
.ipynb_checkpoints/
/.ipynb_checkpoints/*

# Ignore monitoring/logging data
loki/*
grafana/*
prometheus/
promtail-positions/

# =======================================
# STATS & ANALYSIS SOFTWARE
# =======================================

# Stata
*.dta
*.gph
*.smcl

# SAS
*.sas7bdat
*.sas
*.lst
*.log

# SPSS
*.sav
*.spv
*.spo
*.sps
*.zsav

# JASP, JMP, Minitab, Stan
*.jasp
*.jmp
*.jsl
*.jrn
*.stan
*.stanc
*.hpp

# MATLAB/Octave
*.mat
*.mlx~
*.mlx.mldatx
codegen/
octave-workspace

# R
.Rhistory
.RData
.Renviron
*.utf8.md
*.knit.md
.Rproj.user/
vignettes/*.html
vignettes/*.pdf

# Analysis and reports
results/
analysis/
figures/
tables/
outputs/
temp/
cache/

# =======================================
# PLATFORM & INFRASTRUCTURE
# =======================================

# Ignore sensitive cloud and infrastructure files
.gcloud/
.kube/
.helm/
.aws/
.azure/
ansible-vault.txt
.vault_pass
*.p12
*.jks
*.keystore
*.truststore

# Ignore credentials and API tokens
*.token
*.apikey
*.api_key
*.secret
*.credentials
