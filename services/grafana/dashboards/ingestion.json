        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_receiver_refused_log_records_total{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "logs: {{receiver}}",
          "refId": "C"
