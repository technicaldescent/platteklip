                },
                "1": {
                  "text": "Running",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "row",
      "title": "Traction Motors (Left / Right)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Motor Current",
      "description": "Traction motor current in amperes. Left = VFD Drive 2, Right = VFD Drive 4. Compare left/right balance \u2014 sustained divergence indicates mechanical drag or wiring fault.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "platteklip_edge_traction_left_motor_current_amperes{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "Left {{edge_vehicle_id}}",
          "refId": "A"
        },
        {
          "expr": "platteklip_edge_traction_right_motor_current_amperes{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "Right {{edge_vehicle_id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Motor Voltage",
