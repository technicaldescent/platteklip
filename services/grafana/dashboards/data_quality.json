{
  "uid": "data-quality",
  "title": "Data Quality",
  "tags": [
    "pipeline",
    "quality",
    "edge"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2
      },
      {
        "name": "vehicle",
        "label": "Vehicle",
        "type": "query",
        "query": "label_values(platteklip_edge_pump_running, edge_vehicle_id)",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Signal Status Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Anomalous Signals",
      "description": "Count of distinct metrics currently annotated as anomalous by the transform/weaver processor. Covers conveyor frequency, conveyor switch position, vehicle speed, and any future signals with range checks.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_conveyor_frequency{edge_signal_status=\"anomalous\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_controls_conveyor_switch_position{edge_signal_status=\"anomalous\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "B",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_vehicle_speed{edge_signal_status=\"anomalous\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "C",
          "instant": true,
          "range": false,
          "hide": true
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "Total Anomalous",
            "replaceFields": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Under Investigation",
      "description": "Count of distinct metrics currently annotated as under_investigation. Covers pump temperature and conveyor temperature (both reading all zeros).",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_pump_temperature{edge_signal_status=\"under_investigation\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_conveyor_temperature{edge_signal_status=\"under_investigation\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "B",
          "instant": true,
          "range": false,
          "hide": true
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "Total Under Investigation",
            "replaceFields": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "In Development",
      "description": "Count of distinct metrics annotated as in_development. Covers vehicle orientation (zeroing procedure pending).",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_vehicle_orientation{edge_signal_status=\"in_development\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "OK Signals",
      "description": "Count of distinct metrics where the transform/weaver processor confirmed the value is within expected range.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_conveyor_frequency{edge_signal_status=\"ok\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_pump_temperature{edge_signal_status=\"ok\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "B",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_conveyor_temperature{edge_signal_status=\"ok\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "C",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_controls_conveyor_switch_position{edge_signal_status=\"ok\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "D",
          "instant": true,
          "range": false,
          "hide": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "count(platteklip_edge_vehicle_speed{edge_signal_status=\"ok\", edge_vehicle_id=~\"${vehicle}\"}) or vector(0)",
          "refId": "E",
          "instant": true,
          "range": false,
          "hide": true
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reduce": {
              "reducer": "sum"
            },
            "alias": "Total OK",
            "replaceFields": true
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Anomalous Signal Values",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Conveyor Frequency",
      "description": "Expected range: 0\u201350 Hz. Values outside this range are annotated as anomalous by the transform/weaver processor.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "platteklip_edge_conveyor_frequency{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}} ({{edge_signal_status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": -10,
          "max": 60,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Conveyor Switch Position",
      "description": "Expected range: 0\u2013100%. Currently observing values in range 10\u201372.",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "platteklip_edge_controls_conveyor_switch_position{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}} ({{edge_signal_status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": -5,
          "max": 105,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Vehicle Speed (raw)",
      "description": "Raw PLC value (MPH \u00d7 10). Currently anomalous: values are 0 or 1 only.",
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "platteklip_edge_vehicle_speed{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}} ({{edge_signal_status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Zero-Value Signals (Under Investigation)",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pump Temperature",
      "description": "Expected to report degrees Celsius. Currently reads all zeros \u2014 VFD Drive 1 temperature register under investigation.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "platteklip_edge_pump_temperature{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}} ({{edge_signal_status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": -5,
          "max": 120,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Conveyor Temperature",
      "description": "Expected to report degrees Celsius. Currently reads all zeros \u2014 VFD Drive 3 temperature register under investigation.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "platteklip_edge_conveyor_temperature{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}} ({{edge_signal_status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": -5,
          "max": 120,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Transform Processor",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Weaver Processor Throughput",
      "description": "Rate of metric data points accepted by the transform/weaver processor. A drop to zero indicates the processor is not receiving data from the metrics pipeline.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_processor_accepted_metric_points_total{job=\"otel-collector-internal\", processor=\"transform/weaver\"}[1m])",
          "legendFormat": "Accepted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_processor_refused_metric_points_total{job=\"otel-collector-internal\", processor=\"transform/weaver\"}[1m])",
          "legendFormat": "Refused",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_processor_dropped_metric_points_total{job=\"otel-collector-internal\", processor=\"transform/weaver\"}[1m])",
          "legendFormat": "Dropped",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Refused"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dropped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "logs",
      "title": "Signal Anomaly Events",
      "description": "Log records from the OTel SDK where the signal anomaly detection logic emitted a warning. Filter by service_name to narrow.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{service_name=\"mqtt-producer\"} |~ \"anomal|signal_status\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "schemaVersion": 39,
  "version": 3
}
