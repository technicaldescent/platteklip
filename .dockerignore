# =============================================================
# exclude everything; allow only what the build stage needs.
# =============================================================

# Deny all by default.
*

# Allow only the files the Dockerfile COPYs.
!pyproject.toml
!src/platteklip/

# Re-exclude artefacts that may appear inside allowed paths.
**/__pycache__
**/*.pyc
**/*.pyo
**/.mypy_cache
**/.pytest_cache
**/*.egg-info
