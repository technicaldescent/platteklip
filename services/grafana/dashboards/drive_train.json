{
  "uid": "drive-train",
  "title": "Drive Train",
  "tags": [
    "vehicle",
    "edge",
    "motors",
    "vfd"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2
      },
      {
        "name": "vehicle",
        "label": "Vehicle",
        "type": "query",
        "query": "label_values(platteklip_edge_pump_running, edge_vehicle_id)",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prometheus}"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Motor Status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Traction Left",
      "description": "Left traction motor running state. Source: VFD Drive 2.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "platteklip_edge_traction_left_running{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "red"
                },
                "1": {
                  "text": "Running",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Traction Right",
      "description": "Right traction motor running state. Source: VFD Drive 4.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "expr": "platteklip_edge_traction_right_running{edge_vehicle_id=~\"${vehicle}\"}",
          "legendFormat": "{{edge_vehicle_id}}",
          "refId": "A",
