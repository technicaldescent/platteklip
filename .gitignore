# =================================================================
# SECURITY AND COMPLIANCE
# =================================================================
# Compliance Framework Coverage & Controls:
# - CIS GitLab Benchmark v1.0.1
#   - 1.5.1: Sensitive Data Detection
#   - 1.5.2: CI Pipeline Security
#   - 2.1.7: Build Secrets Management
# - ISO 27001:2013
#   - A.10: Cryptography
#   - A.12: Operations Security
#   - A.14: System Development
# - NIST 800-53 Rev 5
#   - SC-12: Cryptographic Key Management
#   - SC-28: Protection of Information at Rest
#   - SI-7: Software and Information Integrity
# - SOC 2 Type II
#   - CC6.1: Logical Access Security
#   - CC8.1: Change Management

# =================================================================
# Environment & Configuration Files
# Controls:
# - NIST 800-53: CM-6 (Configuration Settings)
# - CIS Controls v8: 16.1 (Secure Development Process)
# - ISO 27001: A.12.1.4 (Development/Testing Separation)
# =================================================================
# Secrets and Environment Variables
.env                    # Environment variables
.env.*                  # All env variations
!.env.example           # Allow example env
!.env.template          # Allow templates
.envrc                  # Direnv config
*.env.local             # Local overrides
*.env.*.local           # Environment-specific overrides
.config.json            # Configuration files
*.config.local.*        # Local configs
config.*.json           # JSON configs
*.env.ci                # CI environment files
.ci_secrets/            # CI secrets directory

# Local Overrides
*.override.yml          # YAML overrides
*.override.yaml         # YAML overrides
*.override.json         # JSON overrides
local.settings.json     # Local settings

**/*.env                # Nested environment files
**/secrets/             # Recursive secrets directories
**/credentials/**       # Recursive credentials
*.jfif                  # Potential steganography risk
*.heic                  # Image format that can conceal data

# =================================================================
# Cryptographic Materials
# Controls:
# - NIST 800-53: SC-12 (Cryptographic Key Management)
# - ISO 27001: A.10.1.2 (Key Management)
# - CIS Controls v8: 3.11 (Encrypt Data at Rest)
# =================================================================
# SSH Keys and Config
**/.ssh/               # SSH directory
id_rsa                # RSA private key
id_rsa.pub            # RSA public key
id_ecdsa              # ECDSA private key
id_ecdsa.pub          # ECDSA public key
id_ed25519            # ED25519 private key
id_ed25519.pub        # ED25519 public key
known_hosts           # SSH known hosts
authorized_keys       # Authorized keys
.ssh/config           # SSH config
.sshd_config          # SSH daemon config

# PKI & Certificates
*.pem                 # Privacy Enhanced Mail format
*.key                 # Private keys
*.crt                 # Certificates
*.cer                # Alternative cert format
*.der                # DER encoded certificates
*.p7b                # PKCS#7 certificates
*.p7r                # PKCS#7 request
*.spc                # Software Publishing Cert
*.pfx                # PKCS#12 format
*.p12                # PKCS#12 alternate
*.crl                # Certificate Revocation List

# Certificate Stores
.ca/                  # Certificate Authority
pki/                  # PKI infrastructure
cacerts/             # CA certificates
*.keystore           # Java keystore
*.jks                # Java key store
*.truststore         # Trust store

# GPG/PGP Keys
*.gpg                # GPG key
*.pgp                # PGP key
*.asc                # ASCII armored key
secring.*            # Secret keyring
pubring.*            # Public keyring
trustdb.gpg          # Trust database
*.kbx                # New keybox format
*.kbx~               # Keybox backup
.gnupg/              # GPG config directory

# =================================================================
# CI/CD Pipeline Security
# Controls:
# - CIS GitLab: 1.5.2 (Pipeline Security)
# - NIST 800-53: SA-11 (Developer Security Testing)
# - ISO 27001: A.14.2.8 (System Security Testing)
# =================================================================
# Security Scanning
.gitlab/security-reports/       # Security reports
.gitlab-security/               # Security configs
**/security-scan-*.json         # Scan results
**/dast-*.json                  # DAST results
**/sast-*.json                  # SAST results
**/dependency-scan-*.json       # Dependency scans

# Pipeline Configuration
.gitlab-ci.secrets.yml          # Pipeline secrets
.gitlab-ci.*.secrets.yml        # Pipeline env secrets
.gitlab/merge-rules-*.json      # Merge rules
.gitlab/branch-rules-*.json     # Branch protection

# =================================================================
# Audit & Compliance
# Controls:
# - NIST 800-53: AU-2 (Audit Events)
# - ISO 27001: A.12.4 (Logging and Monitoring)
# - SOC 2: CC7.2 (Security Incident Procedures)
# =================================================================
# Audit Records
audit/                          # Audit directory
*.audit.log                     # Audit logs
*-audit-*.json                  # Audit data
evidence/                       # Audit evidence
*.evidence.pdf                  # Evidence files

# Security Documentation
security-policies/              # Security policies
procedures/                     # Security procedures
**/security-*.md                # Security documentation
**/compliance-*.pdf             # Compliance docs

# Security Assessments
vulnerabilities/                # Vulnerability dir
**/vulnerability-*.json         # Vulnerability data
**/security-*.json              # Security findings
.gitlab-sast/                   # SAST results
.gitlab-dast/                   # DAST results
dependency-check-report.json    # Dependency check

# =================================================================
# Platform & Infrastructure
# Controls:
# - CIS Controls v8: 4.1 (Secure Configuration Process)
# - ISO 27001: A.13.1 (Network Security)
# - NIST 800-53: CM-2 (Baseline Configuration)
# =================================================================
# Cloud Provider Credentials
.aws/                           # AWS config
credentials                     # AWS credentials
aws_access_key_id               # AWS access key
aws_secret_access_key           # AWS secret key
.azure/                         # Azure config
.gcloud/                        # Google Cloud
*.publishsettings               # Azure publish settings
.gcp/                   # Google Cloud config
azure_profile.json      # Azure profile
.c9/                    # AWS Cloud9
amplify/                # AWS Amplify

# Infrastructure Configuration
terraform.tfstate*              # Terraform state
.terraform/                     # Terraform directory
*.tfvars                        # Terraform variables
*.tfvars.json                   # Terraform JSON vars
ansible-vault.txt               # Ansible Vault
.terraformrc                    # Terraform config
terraform.rc                    # Terraform runtime
.vagrant/                       # Vagrant files

# Container Security
.docker/                        # Docker directory
.dockercfg                      # Docker config
docker.conf                     # Docker settings
.docker/config.json             # Docker credentials
.trivyignore                    # Trivy scanner ignore
.containerignore                # Container ignore

