        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Drive Frequency",
      "description": "Traction motor drive frequency in Hz. Left = VFD Drive 2, Right = VFD Drive 4. Difference between left and right produces the steering angle.",
