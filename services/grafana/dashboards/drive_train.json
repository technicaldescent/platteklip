    {
      "type": "timeseries",
      "title": "Conveyor Frequency",
      "description": "Conveyor drive frequency in Hz. Expected range: 0\u201350 Hz. Currently anomalous: values observed in range \u22125 to 5. The edge_signal_status label shows the annotation from the transform/weaver processor.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
