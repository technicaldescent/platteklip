        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_processor_refused_spans_total{job=\"otel-collector-internal\", processor=\"memory_limiter\"}[1m])",
          "legendFormat": "spans",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_processor_refused_metric_points_total{job=\"otel-collector-internal\", processor=\"memory_limiter\"}[1m])",
