          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "never",
            "stacking": {}
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Failed Exports/s",
      "description": "Rate of failed export attempts per exporter and signal type. Non-zero values indicate a downstream is unreachable or rejecting data (e.g. Kafka connection refused, Loki 429).",
