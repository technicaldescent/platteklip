    {
      "type": "row",
      "title": "Errors and Drops",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Refused at Receiver/s",
      "description": "Spans rejected by the OTLP receiver before entering the pipeline. Common causes: malformed payloads, authentication failures, or receiver-level rate limiting.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_receiver_refused_spans_total{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "spans: {{receiver}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "rate(otelcol_receiver_refused_metric_points_total{job=\"otel-collector-internal\"}[1m])",
          "legendFormat": "metrics: {{receiver}}",
          "refId": "B"
