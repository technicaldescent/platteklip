    {
      "type": "timeseries",
      "title": "Exporter Queue Depth",
      "description": "Number of batches waiting in each exporter's send queue. Sustained growth indicates the downstream is slower than the ingest rate. Queue capacity is configured per exporter in the collector config.",
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
