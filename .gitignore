# Security Level: Medium - Prevents exposure of workflow artifacts
# Compliance: GitHub Enterprise security best practices

# GitHub Actions
.github/actions/           # Local Action repositories
.github/workspaces/        # GitHub Workspaces
action-artifacts/          # Action workflow artifacts
*.action.yml               # Local Action definitions
*.action.yaml

# GitHub Pages
_site/                    # Jekyll build output
.jekyll-cache/           # Jekyll cache directory
.github/pages/           # Pages deployment artifacts

# GitHub Codespaces
.devcontainer/           # Codespaces configuration (cache)
.codespaces/             # Codespaces metadata
.devcontainer.json       # Alternate configuration

# GitHub Dependency Graph
dependency-graph/        # Dependency graph data
.generated-dependencies/ # Auto-generated dependencies

# GitHub Security
codeql-database/         # CodeQL database outputs
github-apps/             # Local GitHub Apps configuration
*.github-token           # GitHub token files
*.github-secret          # GitHub secret files

# GitHub Discussions
discussions/             # Local discussions cache
*.discussion.json        # Discussion data files

# GitHub Sponsors
.sponsors/               # Sponsors configuration data

# =================================================================
# GITLAB PLATFORM
# =================================================================
# Purpose: GitLab-specific files and directories that may contain
#          sensitive information, CI/CD artifacts, or security reports
# Security Level: High - Prevents exposure of pipeline artifacts and tokens
# Compliance: GitLab Enterprise security best practices

# -------------------------------
# GitLab CI/CD Artifacts
# -------------------------------
.gitlab/ci/               # Local CI configuration variants
.gitlab/runner-token      # Runner registration token
.gitlab/runner-cache/     # Runner cache directories
.gitlab/artifacts/        # Pipeline artifacts (local)
.gitlab/job-output/       # Individual job output files

# -------------------------------
# GitLab Security Reports
# -------------------------------
.gitlab/security-reports/       # Security scanning reports :cite[1]
.gitlab-secrets/                # Secret detection results
.gitlab-dependency-scan/        # Dependency scanning results
.gitlab-sast/                   # Static Application Security Testing :cite[1]
.gitlab-dast/                   # Dynamic Application Security Testing :cite[1]
.gitlab-container-scan/         # Container scanning reports
.gitlab-api-fuzzing/            # API fuzzing results

# -------------------------------
# GitLab Merge and Branch Rules
# -------------------------------
.gitlab/merge-rule-*.json      # Merge request rules :cite[1]
.gitlab/branch-rule-*.json     # Branch protection rules :cite[1]

# -------------------------------
# GitLab Local Development
# -------------------------------
.gitlab-webide.yml             # Web IDE configuration
.gitlab-local-ci.yml           # Local CI testing configuration
.gitlab-runner-config.toml     # Local runner configuration
.gitlab/runner-config/         # Runner configuration directory

