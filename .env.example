###############################################################################
#                                                                             #
#  IMPORTANT: This file contains non-secret configuration.                    #
#  >>> ALL SECRETS ARE MANAGED EXTERNALLY (e.g., Vault, Docker Secrets) <<<   #
#                                                                             #
###############################################################################

# --- Project & Infrastructure ---
PROJECT_ROOT=./services/

# Local (offline) NTP for isolated industrial networks.
# For internet-connected systems, use a dedicated NTP server or reliable pool.
NTP_SERVERS="127.127.1.1"

# --- Service Port Assignments (Category: External Access / Proxied) ---
# These services are likely exposed to users via the reverse proxy (NGINX).
GRAFANA_PORT=3000
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_HTTPS_PORT= 8443
SYSTEM_UNDER_TEST_PORT=8084
JAEGER_UI_PORT=16686

# --- Service Port Assignments (Category: Internal Only) ---
# These should only be accessible within the Docker network/internal host.
# They should be blocked by the host firewall from external access.

# Observability - Data Ingestion
PROMETHEUS_PORT=9090
LOKI_PORT=3100
ALLOY_PORT=12345
OTLP_GRPC_PORT=4317              # OpenTelemetry Collector
OTLP_HTTP_PORT=4318              # OpenTelemetry Collector
COLLECTOR_METRICS_PORT=8889      # OpenTelemetry Collector

# Publish and Subscribe
MOSQUITTO_PORT=1883
KAFKA_PORT=29092

# --- Service Port Assignments (Category: Management / Admin) ---
# These ports are for service health, metrics, and administration.
# Strictly firewalled; access only from specific management hosts.
KEYCLOAK_MANAGEMENT=9000
PROMETHEUS_ADMIN_PORT=9091
NGINX_ADMIN_PORT=81
JAEGER_ADMIN_PORT=14269
JAEGER_METRICS_PORT=8888
JAEGER_HEALTHCHECK_PORT=13133
JAEGER_HTTP_API_PORT=14268
JAEGER_GRPC_PORT=14250
JAEGER_AGENT_PORT=6831

# --- Service Configuration (Non-Secret) ---
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=1

# --- Reverse Proxy (NGINX) Configuration ---
# NGINX itself binds to these ports on the host.
NGINX_PORT=80
NGINX_SSL_PORT=443
