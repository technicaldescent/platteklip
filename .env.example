###############################################################################
#                                                                             #
#  IMPORTANT: This file contains non-secret configuration.                    #
#  >>> ALL SECRETS ARE MANAGED EXTERNALLY (e.g., Vault, Docker Secrets) <<<   #
#                                                                             #
###############################################################################

# =============================================================================
# Project & Infrastructure
# =============================================================================
PROJECT_ROOT=./services/
COMPOSE_PROJECT_NAME=telemetry-stack
TZ=UTC

# Offline Network Time Protocol (NTP) for isolated networks.
# For internet-connected systems, use a dedicated NTP server or reliable pool.
NTP_SERVERS=127.127.1.1

# =============================================================================
# Service Hostnames (Internal Docker Network)
# =============================================================================
OTEL_COLLECTOR_HOST=otel-collector
MQTT_BROKER_HOST=mqtt-broker
KAFKA_BROKER_HOST=kafka
PROMETHEUS_HOST=prometheus
LOKI_HOST=loki
GRAFANA_HOST=grafana
JAEGER_HOST=jaeger

# =============================================================================
# External Access Ports (User-Facing / Proxied via NGINX)
# =============================================================================
# These services are exposed to users via the reverse proxy.
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_HTTPS_PORT=8443

# =============================================================================
# Internal Service Ports (Docker Network Only)
# =============================================================================
# These should ONLY be accessible within the Docker network.
# Block these ports at the host firewall level from external access.

# --- Observability: Data Ingestion ---
ALLOY_PORT=12345
LOKI_PORT=3100
LOKI_GRPC_PORT=9095
PROMETHEUS_PORT=9090

# OpenTelemetry Collector
OTLP_GRPC_PORT=4317
OTEL_COLLECTOR_HEALTHCHECK_PORT=13133
OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_METRICS_PORT=8889
OTEL_EXPORTER_OTLP_ENDPOINT=http://${OTEL_COLLECTOR_HOST}:${OTLP_GRPC_PORT}

# --- Stream Processing ---
FLINK_JOBMANAGER_RPC_PORT=6123
FLINK_JOBMANAGER_UI_PORT=8081

# --- Message Brokers ---
# MQTT
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# Kafka
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=9094
KAFKA_CONNECT_PORT=8083
KAFKA_JMX_PORT=9999
KSQLDB_PORT=8088

# =============================================================================
# Management & Admin Ports (STRICTLY FIREWALLED)
# =============================================================================
# These ports expose health checks, metrics, and admin APIs.
# Access should be restricted to specific management hosts/networks only.

KEYCLOAK_MANAGEMENT_PORT=9000
PROMETHEUS_ADMIN_PORT=9091
NGINX_ADMIN_PORT=81

# Jaeger Admin/Monitoring
JAEGER_ADMIN_PORT=14269
JAEGER_METRICS_PORT=8888

# Jaeger Data Ingestion (Internal)
JAEGER_COLLECTOR_HTTP_PORT=14268
JAEGER_COLLECTOR_GRPC_PORT=14250
JAEGER_AGENT_COMPACT_PORT=6831
JAEGER_AGENT_BINARY_PORT=6832

# =============================================================================
# Reverse Proxy Configuration (NGINX)
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# Service Configuration (Non-Secret)
# =============================================================================

# Jaeger Sampling
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=1.0

# Log Levels
LOG_LEVEL=debug
OTEL_LOG_LEVEL=debug
KAFKA_LOG_LEVEL=DEBUG

# Resource Limits (Adjust based on workload)
JAVA_OPTS=-Xmx2g -Xms512m
KAFKA_HEAP_OPTS=-Xmx1g -Xms512m

# =============================================================================
# Feature Flags / Optional Components
# =============================================================================
ENABLE_JAEGER_SAMPLING=true
ENABLE_KAFKA_JMX=true
ENABLE_PROMETHEUS_REMOTE_WRITE=false
