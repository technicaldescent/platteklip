# - ISO 27001: A.12.5 (Control of Operational Software)
# =================================================================
# Registry Authentication
.npmrc               # NPM config
.yarnrc             # Yarn config
.bundle/config      # Ruby config
pip.conf            # Python pip config
.pypirc             # Python package index
.gem/credentials    # Ruby gems
_netrc              # Network auth

# Build Artifacts
*.jks.bak           # Java keystore backup
*.keystore.bak      # Keystore backup
*.p12.bak           # PKCS#12 backup
artifacts.*.key     # Artifact keys
signing.properties  # Signing config

# =================================================================
# Authentication & Access
# Controls:
# - CIS Controls v8: 6.3-6.5 (Access Control)
# - ISO 27001: A.9 (Access Control)
# - NIST 800-53: AC-3 (Access Enforcement)
# =================================================================
# Access Tokens
*.key                # Key files
.key                # Hidden keys
api.key             # API keys
*.token             # Token files
.token              # Hidden tokens
.api_key            # API keys
*token*             # Token patterns
*secret*            # Secret patterns

# Access Control Files
.htpasswd           # Apache auth
.htaccess           # Apache access
.user.ini           # PHP user config
.credentials/       # Credentials dir
auth.json           # Auth config
permissions.acl     # ACL files

